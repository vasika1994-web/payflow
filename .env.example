# Скопировать в .env при необходимости, у всего есть дефолты.

# Порты на хосте (compose)
POSTGRES_PORT=5433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=8000
WEBHOOK_SINK_PORT=9000

# Приложение (только для запуска без Docker; для тестов DATABASE_URL задавать не нужно)
ENV=development
LOG_LEVEL=INFO
# DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5433/payments
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
API_KEY=local-dev-api-key

# Эмуляция шлюза
GATEWAY_DELAY_MIN_SECONDS=2
GATEWAY_DELAY_MAX_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_UNAVAILABLE_RATE=0

# Retry / DLQ
CONSUMER_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
WEBHOOK_TIMEOUT_SECONDS=5
